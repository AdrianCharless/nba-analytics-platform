# Databricks workspace connection
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_personal_access_token

# Databricks SQL Warehouse (used by the Streamlit dashboard)
DATABRICKS_SQL_HTTP_PATH=/sql/1.0/warehouses/your_warehouse_id

# Kafka broker address (container-network address; use localhost:9092 if connecting from outside Docker)
KAFKA_BROKER=kafka:29092
